<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Atividade 10</title>
</head>
<body>

    <h1>Troca de imagens</h1>

    <img id="imagem" src="https://picsum.photos/id/237/600/400">

    <script>

        const imagens = [
            "https://picsum.photos/id/237/600/400",
            "https://picsum.photos/id/238/600/400",
            "https://picsum.photos/id/239/600/400",
            "https://picsum.photos/id/240/600/400"
        ];

        let indice = 0;

        function trocarImagem() {

            let imagem = document.getElementById("imagem");

            imagem.src = imagens[indice];

            indice++;

            if (indice == imagens.length) {

                indice = 0;

            }

        }

        setInterval(trocarImagem, 5000);

    </script>

</body>
</html>
